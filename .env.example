# Copy to .env for local development. NEVER commit a real .env.
# In production (Coolify) set these in the app's Environment Variables UI.

# Flask session signing. Generate with:  python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=change-me

# HTTP Basic auth for /admin. Both must be set or /admin returns 401.
ADMIN_USER=admin
ADMIN_PASS=change-me

# SQLite path for analytics events. On Coolify, point this at a mounted
# persistent volume (e.g. /data/analytics.db) so it survives redeploys.
ANALYTICS_DB_PATH=analytics.db
